<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundDock</RootNamespace>
    <AssemblyName>SoundDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>SoundDock</Product>
    <Description>A compact taskbar sound controller.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Keep the bundled runtime's redistribution notices next to the portable EXE. -->
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_NoticePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <_RuntimeNotice Include="%(_NoticePack.PackageDirectory)/LICENSE*;%(_NoticePack.PackageDirectory)/THIRD-PARTY-NOTICES*">
        <NoticePackage>%(_NoticePack.NuGetPackageId)</NoticePackage>
      </_RuntimeNotice>
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeNotice)" DestinationFiles="@(_RuntimeNotice->'$(PublishDir)runtime-notices/%(NoticePackage)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
